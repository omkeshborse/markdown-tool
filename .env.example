# NEXT_PUBLIC_SITE_URL: The canonical base URL for the site in production.
# Used to generate absolute URLs in sitemap.xml, robots.txt, Open Graph, and canonical metadata.
# Required before deploying to production (e.g. on Netlify or custom hosting).
# For local development, defaults to "http://localhost:3000" if unset.
#
# Example:
# NEXT_PUBLIC_SITE_URL="https://your-custom-domain.com"
NEXT_PUBLIC_SITE_URL="https://your-custom-domain.com"
